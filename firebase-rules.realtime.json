{
  "rules": {
    ".read": false,
    ".write": false,

    "admins": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('admins').child(auth.uid).val() === true)",
        ".write": "auth != null && root.child('admins').child(auth.uid).val() === true",
        ".validate": "newData.isBoolean()"
      }
    },

    "conversations": {
      "$conversationId": {
        ".read": "auth != null && (root.child('admins').child(auth.uid).val() === true || data.child('visitorId').val() === auth.uid)",
        ".write": "auth != null && (root.child('admins').child(auth.uid).val() === true || (!data.exists() && newData.child('visitorId').val() === auth.uid) || (data.exists() && data.child('visitorId').val() === auth.uid))",
        "visitorId": {
          ".validate": "newData.isString()"
        },
        "visitorName": {
          ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 100)"
        },
        "visitorContact": {
          ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 120)"
        },
        "status": {
          ".validate": "!newData.exists() || (newData.isString() && (newData.val() === 'open' || newData.val() === 'closed'))"
        },
        "lastMessage": {
          ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 420)"
        }
      }
    },

    "messages": {
      "$conversationId": {
        ".read": "auth != null && (root.child('admins').child(auth.uid).val() === true || root.child('conversations').child($conversationId).child('visitorId').val() === auth.uid)",
        "$messageId": {
          ".write": "auth != null && (root.child('admins').child(auth.uid).val() === true || root.child('conversations').child($conversationId).child('visitorId').val() === auth.uid)",
          ".validate": "newData.hasChildren(['senderType','text','createdAt']) && newData.child('text').isString() && newData.child('text').val().length > 0 && newData.child('text').val().length <= 420 && (newData.child('senderType').val() === 'visitor' || newData.child('senderType').val() === 'admin')"
        }
      }
    },

    "typing": {
      "$conversationId": {
        "visitor": {
          ".read": "auth != null && (root.child('admins').child(auth.uid).val() === true || root.child('conversations').child($conversationId).child('visitorId').val() === auth.uid)",
          ".write": "auth != null && root.child('conversations').child($conversationId).child('visitorId').val() === auth.uid",
          ".validate": "newData.hasChildren(['isTyping'])"
        },
        "admin": {
          ".read": "auth != null && (root.child('admins').child(auth.uid).val() === true || root.child('conversations').child($conversationId).child('visitorId').val() === auth.uid)",
          ".write": "auth != null && root.child('admins').child(auth.uid).val() === true",
          ".validate": "newData.hasChildren(['isTyping'])"
        }
      }
    },

    "presence": {
      "$conversationId": {
        "visitor": {
          ".read": "auth != null && (root.child('admins').child(auth.uid).val() === true || root.child('conversations').child($conversationId).child('visitorId').val() === auth.uid)",
          ".write": "auth != null && root.child('conversations').child($conversationId).child('visitorId').val() === auth.uid",
          ".validate": "newData.hasChildren(['isOnline'])"
        },
        "admin": {
          ".read": "auth != null && (root.child('admins').child(auth.uid).val() === true || root.child('conversations').child($conversationId).child('visitorId').val() === auth.uid)",
          ".write": "auth != null && root.child('admins').child(auth.uid).val() === true",
          ".validate": "newData.hasChildren(['isOnline'])"
        }
      }
    },

    "admin_push_tokens": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('admins').child(auth.uid).val() === true)",
        "$tokenKey": {
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.hasChildren(['token']) && newData.child('token').isString()"
        }
      }
    },

    "mensajes_contacto": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$msg": {
        ".write": "auth != null",
        ".validate": "newData.hasChildren(['nombre','contacto','mensaje'])"
      }
    }
  }
}
