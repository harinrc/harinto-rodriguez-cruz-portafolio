{
"rules": {
".read": false,
".write": false,
  "admins": {
  "$uid": {
    ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
    ".write": false,
    ".validate": "newData.isBoolean()"
  }
},

"conversations": {
  ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
  ".indexOn": ["updatedAt"],

  "$conversationId": {
    ".read": "auth != null && (data.child('visitorId').val() === auth.uid || root.child('admins').child(auth.uid).val() === true)",
    ".write": "auth != null && ((!data.exists() && newData.child('visitorId').val() === auth.uid) || (data.exists() && (data.child('visitorId').val() === auth.uid || root.child('admins').child(auth.uid).val() === true)))",

    "conversationId": {
      ".validate": "newData.isString() && newData.val() === $conversationId"
    },
    "visitorId": {
      ".validate": "newData.isString() && (newData.val() === auth.uid || (data.exists() && newData.val() === data.val()))"
    },
    "visitorName": {
      ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 70"
    },
    "visitorContact": {
      ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 100"
    },
    "status": {
      ".validate": "newData.isString() && (newData.val() === 'open' || newData.val() === 'closed')"
    },
    "source": {
      ".validate": "newData.isString() && newData.val().length <= 60"
    },
    "createdAtIso": {
      ".validate": "newData.isString()"
    },
    "updatedAtIso": {
      ".validate": "newData.isString()"
    },
    "createdAt": {
      ".validate": "newData.isNumber()"
    },
    "updatedAt": {
      ".validate": "newData.isNumber()"
    },
    "lastMessage": {
      ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 420"
    },

    "$other": {
      ".validate": false
    }
  }
},

"messages": {
  "$conversationId": {
    ".read": "auth != null && (root.child('conversations').child($conversationId).child('visitorId').val() === auth.uid || root.child('admins').child(auth.uid).val() === true)",
    ".indexOn": ["createdAt"],

    "$messageId": {
      ".write": "auth != null && ((newData.child('senderType').val() === 'visitor' && root.child('conversations').child($conversationId).child('visitorId').val() === auth.uid && newData.child('visitorId').val() === auth.uid) || (root.child('admins').child(auth.uid).val() === true && newData.child('senderType').val() === 'admin'))",

      "senderType": {
        ".validate": "newData.isString() && (newData.val() === 'visitor' || newData.val() === 'admin')"
      },
      "text": {
        ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 420"
      },
      "visitorId": {
        ".validate": "newData.isString() && ((newData.parent().child('senderType').val() === 'visitor' && newData.val() === auth.uid) || (newData.parent().child('senderType').val() === 'admin' && newData.val() === root.child('conversations').child($conversationId).child('visitorId').val()))"
      },
      "conversationId": {
        ".validate": "newData.isString() && newData.val() === $conversationId"
      },
      "createdAt": {
        ".validate": "newData.isNumber()"
      },
      "createdAtIso": {
        ".validate": "newData.isString()"
      },

      "$other": {
        ".validate": false
      }
    }
  }
},

"mensajes_contacto": {
  "$mensaje_id": {
    ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
    ".write": "auth != null && newData.child('conversationId').isString() && root.child('conversations').child(newData.child('conversationId').val()).child('visitorId').val() === auth.uid",

    "nombre": {
      ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 70"
    },
    "contacto": {
      ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 100"
    },
    "mensaje": {
      ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 420"
    },
    "fecha": {
      ".validate": "newData.isString()"
    },
    "conversationId": {
      ".validate": "newData.isString()"
    },

    "$other": {
      ".validate": false
    }
  }
}
}
}